# -*- coding: utf-8 -*-
# =============================================================================
# CSM V3 -- DRIVE HUB  V2.4.2
# =============================================================================
# File:    CSM_V3_DriveHub_V2_4_2.FCMacro
# Date:    April 2026
# Target:  C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\freecad_macros\
#
# CHANGE FROM V2.4.1 (slot geometry correction):
#   The V2.4 and V2.4.1 macros had a slot that started at Y=0 (shaft center)
#   and extended to Y=+26 (past +Y outer edge). The code COMMENT claimed
#   "leaves ~6mm bridge below shaft" but the actual geometry didn't match.
#   The slot terminated AT the shaft center, leaving an awkward sliver
#   of material at the slot bottom.
#
#   V2.4.2 fix:
#     - Slot now extends from Y = -8.1mm to Y = +26mm
#     - This means the slot CLEANLY CROSSES the shaft bore (Y = +/-6.1)
#       with 2mm of overshoot on the -Y side past the bore edge
#     - The remaining material on the -Y side (Y = -25 to Y = -8.1)
#       forms a ~17mm material 'spine' that holds the part together
#     - Clamp action: bolts squeeze the +Y side closed, properly
#       gripping the shaft because the slot CROSSES the bore
#
#   Result:
#     - Geometry now matches design intent precisely
#     - Cleaner print (no thin sliver of material at slot end)
#     - Symmetric clamp deflection (predictable behavior)
#     - Same clamp force, better mechanical reliability
#
# CHANGES INHERITED FROM V2.4.1 (PETG print quality):
#   1. SHAFT_BORE 12.10 -> 12.15mm
#   2. CLAMP_NUT_FLAT 8.5 -> 8.6mm
#   3. CLAMP_NUT_H 4.5 -> 4.8mm
#   4. CSK_TOP_D 10.0 -> 10.2mm
#   5. CSK_DEPTH 3.0 -> 3.2mm
#   6. CLAMP_SLOT_W 2.0 -> 2.2mm
#
# PURPOSE:
#   Couples the CASSETTE to the rotating SHAFT.
#   Provides concentric mounting + secure clamping of cassette to shaft.
#
# ARCHITECTURE (Path A - chosen for simplicity, no pulley drilling):
#
#   Cassette base (above)
#     ↑ 4x M5 flathead screws (UP into cassette M5 inserts)
#   [DRIVE HUB] (this part - clamps to shaft)
#     ↓ shaft passes through 12mm bore
#   60T HTD 5M pulley (already ordered, clamps to shaft separately via its own set screws)
#     ↓ shaft continues down
#   Top bearing housing (V2.4)
#
# DESIGN PHILOSOPHY:
#   - Top-hat shape: small clamp section + wide bolt-mount flange
#   - Split-clamp shaft coupling (like shaft collar design)
#   - Center boss for concentricity (registration feature)
#   - Uses M5 hardware throughout (matches existing inventory)
#   - 100% printable PETG, no special tools needed
#
# HARDWARE USED (ALL ALREADY ORDERED):
#   - 12mm shaft (FEYRINX h8) - hub bore matches
#   - M5 brass heat-set inserts (B0DPQJ4W3Z) - in cassette base
#   - M5 flathead screws (from B0FFSNFK3Y assortment)
#   - M5 socket head cap screws (clamp bolts, from same assortment)
#   - 60T HTD 5M pulley (B0C6Y1462P) - mounts on shaft below hub via its
#     own set screw (NO modification needed)
#   - PETG filament (already have)
#
# NOTE: No drilling of the 60T pulley required. The pulley uses its own
#       set screw to clamp to the shaft. Drive hub is SEPARATE from pulley.
#
# WHY THIS DESIGN VALIDATES YOUR PRELOAD SYSTEM:
#   - Drive hub directly loads the bearings via cassette weight
#   - Shows real-world concentricity of shaft + bearings + cassette
#   - Reveals any wobble/runout introduced by V2.4 spacer tube length
#   - Test before motor mount: ensures clean rotation chain works
#
# AUTO-EXPORT ON RUN:
#   STL:           C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\
#   PNG view:      C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\images\
#   SVG blueprint: C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\blueprints\
# =============================================================================

import FreeCAD, FreeCADGui, Part, math, os

# =============================================================================
# OUTPUT PATHS
# =============================================================================
BASE = r"C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM"

PATH_STL  = os.path.join(BASE, "CSM_V3_DriveHub_V2_4_2.stl")
PATH_PNG  = os.path.join(BASE, "images", "DriveHub_V2_4_2_View.png")
PATH_SVG  = os.path.join(BASE, "blueprints", "DriveHub_V2_4_2_Blueprint.svg")

for p in [PATH_STL, PATH_PNG, PATH_SVG]:
    os.makedirs(os.path.dirname(p), exist_ok=True)

doc = FreeCAD.newDocument("CSM_DriveHub_V2_4_2")

# =============================================================================
# DESIGN PARAMETERS
# =============================================================================
# Shaft interface
SHAFT_D            = 12.0     # FEYRINX 12mm h8 shaft
SHAFT_BORE         = 12.15    # V2.4.1: 12.10 -> 12.15 (PETG hole shrinkage compensation)

# Hub geometry (top-hat shape)
HUB_BODY_OD        = 50.0     # lower portion (clamp + shaft interface)
HUB_BODY_H         = 18.0     # height of clamp section

FLANGE_OD          = 90.0     # upper flange (cassette mount surface)
FLANGE_H           = 7.0      # flange thickness
TOTAL_H            = HUB_BODY_H + FLANGE_H   # 25mm total

# Center boss (concentricity registration - mates with cassette counterbore)
BOSS_OD            = 18.0     # outer diameter
BOSS_H             = 3.0      # protrusion above flange top

# Clamp slot (split-clamp design)
CLAMP_SLOT_W       = 2.2      # V2.4.1: 2.0 -> 2.2 (more clamp travel before bottoming)
# V2.4.2: slot geometry now correctly crosses bore with proper spine
CLAMP_SLOT_OVERSHOOT = 2.0    # mm past shaft bore edge into -Y material
CLAMP_SLOT_DEPTH   = HUB_BODY_OD / 2.0 - 6.0  # leaves ~6mm bridge below shaft

# Clamp bolts (horizontal M5 bolts pulling slot closed)
CLAMP_BOLT_D       = 5.5      # M5 clearance hole
CLAMP_BOLT_HEAD_D  = 9.5      # M5 socket head cap
CLAMP_BOLT_HEAD_H  = 5.0      # head pocket depth
CLAMP_NUT_FLAT     = 8.6      # V2.4.1: 8.5 -> 8.6 (tighter nut grip)
CLAMP_NUT_H        = 4.8      # V2.4.1: 4.5 -> 4.8 (deeper nut trap, fully captures M5 nut)
CLAMP_BOLT_Z1      = 5.0      # lower bolt height
CLAMP_BOLT_Z2      = 13.0     # upper bolt height
CLAMP_BOLT_Y_OFFSET = 16.0    # bolt axis distance from shaft center

# Cassette mount bolts (vertical M5 flathead, threading UP into cassette inserts)
CASSETTE_BOLT_D    = 5.5      # M5 clearance
CASSETTE_BOLT_PCD  = 70.0     # bolt circle diameter
CASSETTE_BOLT_COUNT = 4       # 4 bolts at 90 degree spacing
CSK_TOP_D          = 10.2     # V2.4.1: 10.0 -> 10.2 (margin for flathead seating)
CSK_DEPTH          = 3.2      # V2.4.1: 3.0 -> 3.2 (head fully flush despite print roughness)

CHAMFER_SIZE       = 1.0      # outer edge chamfer

# =============================================================================
# HELPER FUNCTIONS
# =============================================================================
def make_csk_cone(r_head, r_shank, depth):
    """90 degree countersink cone (large radius at top, small at bottom)"""
    return Part.makeCone(r_head, r_shank, depth)

def hex_prism(flat_to_flat, height):
    """Make a hexagonal prism from a 6-sided polygon"""
    pts = []
    R = flat_to_flat / 2.0 / math.cos(math.radians(30))  # vertex distance
    for i in range(6):
        ang = math.radians(i * 60.0)
        pts.append(FreeCAD.Vector(R * math.cos(ang), R * math.sin(ang), 0))
    pts.append(pts[0])  # close polygon
    poly = Part.makePolygon(pts)
    face = Part.Face(Part.Wire(poly))
    return face.extrude(FreeCAD.Vector(0, 0, height))

# =============================================================================
# BUILD DRIVE HUB
# =============================================================================
print("=" * 65)
print("CSM V3 -- DRIVE HUB V2.4.2")
print("=" * 65)
print(f"\nBuilding drive hub...")

# 1. Body cylinder (lower portion - clamp section)
body = Part.makeCylinder(HUB_BODY_OD / 2.0, HUB_BODY_H)

# 2. Flange disc (upper portion - cassette mount)
flange = Part.makeCylinder(FLANGE_OD / 2.0, FLANGE_H)
flange.translate(FreeCAD.Vector(0, 0, HUB_BODY_H))

# 3. Center boss (concentricity feature on top of flange)
boss = Part.makeCylinder(BOSS_OD / 2.0, BOSS_H)
boss.translate(FreeCAD.Vector(0, 0, TOTAL_H))

# 4. Combine into single solid
hub = body.fuse(flange).fuse(boss)

# 5. Shaft bore through entire hub (12.1mm slip fit)
shaft_bore = Part.makeCylinder(SHAFT_BORE / 2.0, TOTAL_H + BOSS_H + 2)
shaft_bore.translate(FreeCAD.Vector(0, 0, -1))
hub = hub.cut(shaft_bore)

# 6. Clamp slot (vertical slot from one side, through clamp section only)
# Slot extends from outer edge through to past shaft, allowing clamp action
slot_w = CLAMP_SLOT_W
slot_h = HUB_BODY_H + 0.1  # slightly above body section
# Slot starts from outer edge of hub body (Y = HUB_BODY_OD/2)
# Cuts inward toward shaft, stops 6mm short of shaft for material bridge
# V2.4.2 FIX: slot crosses shaft bore cleanly, with proper material spine on -Y side
# Slot Y range: from -(SHAFT_BORE/2 + overshoot) to +(HUB_BODY_OD/2 + 1)
# This means slot starts 2mm past shaft bore edge on -Y side, extends past +Y outer edge
# Result: slot fully crosses the bore (clamp action works) but ~17mm of -Y material
#         remains as the structural 'spine' holding the part together
slot_y_start = -(SHAFT_BORE / 2.0 + CLAMP_SLOT_OVERSHOOT)  # = -8.075mm
slot_y_end = HUB_BODY_OD / 2.0 + 1.0                       # = 26.0mm
slot_length_y = slot_y_end - slot_y_start                  # = 34.075mm
slot = Part.makeBox(slot_w, slot_length_y, slot_h)
slot.translate(FreeCAD.Vector(-slot_w / 2.0, slot_y_start, 0))
hub = hub.cut(slot)

# 7. Clamp bolts - 2x M5 horizontal, perpendicular to slot
# Bolts thread along Y axis, pulling clamp closed
# Bolt path: from -Y side (head) through slot to +Y side (nut pocket)
for z_pos in [CLAMP_BOLT_Z1, CLAMP_BOLT_Z2]:
    # M5 clearance through-hole along Y axis
    bolt_hole = Part.makeCylinder(CLAMP_BOLT_D / 2.0, HUB_BODY_OD + 4)
    bolt_hole.rotate(FreeCAD.Vector(0, 0, 0), FreeCAD.Vector(1, 0, 0), 90)  # rotate to Y axis
    bolt_hole.translate(FreeCAD.Vector(0, -HUB_BODY_OD / 2.0 - 2, z_pos))
    hub = hub.cut(bolt_hole)

    # Socket head pocket on -Y side (bolt head)
    head_pocket = Part.makeCylinder(CLAMP_BOLT_HEAD_D / 2.0, CLAMP_BOLT_HEAD_H + 2)
    head_pocket.rotate(FreeCAD.Vector(0, 0, 0), FreeCAD.Vector(1, 0, 0), 90)
    head_pocket.translate(FreeCAD.Vector(0, -HUB_BODY_OD / 2.0 - 2, z_pos))
    hub = hub.cut(head_pocket)

    # M5 hex nut pocket on +Y side (captures nut, prevents rotation)
    nut_pocket = hex_prism(CLAMP_NUT_FLAT + 0.3, CLAMP_NUT_H + 1.0)
    nut_pocket.rotate(FreeCAD.Vector(0, 0, 0), FreeCAD.Vector(1, 0, 0), -90)
    nut_pocket.translate(FreeCAD.Vector(0, HUB_BODY_OD / 2.0 - CLAMP_NUT_H - 1.0, z_pos))
    hub = hub.cut(nut_pocket)

# 8. Cassette mount bolts (4x M5 flathead, threading UP from below into cassette inserts)
# Bolt heads sit FLUSH on bottom face of flange (countersink on flange bottom)
# Through-holes pass through flange thickness
for i in range(CASSETTE_BOLT_COUNT):
    ang = math.radians(i * 360.0 / CASSETTE_BOLT_COUNT + 45.0)  # offset by 45 deg
    bx = (CASSETTE_BOLT_PCD / 2.0) * math.cos(ang)
    by = (CASSETTE_BOLT_PCD / 2.0) * math.sin(ang)

    # Through-hole for M5 shank
    bh = Part.makeCylinder(CASSETTE_BOLT_D / 2.0, FLANGE_H + 2)
    bh.translate(FreeCAD.Vector(bx, by, HUB_BODY_H - 1))
    hub = hub.cut(bh)

    # 90 degree countersink on BOTTOM of flange (head sits flush from below)
    csk = make_csk_cone(CSK_TOP_D / 2.0, CASSETTE_BOLT_D / 2.0, CSK_DEPTH)
    csk.translate(FreeCAD.Vector(bx, by, HUB_BODY_H))
    hub = hub.cut(csk)

# 9. Apply chamfer to outer edges (top of flange + top of boss + bottom of body)
try:
    edges_to_chamfer = []
    for edge in hub.Edges:
        v1, v2 = edge.Vertexes[0].Point, edge.Vertexes[1].Point
        # Horizontal circular edges only (top/bottom of cylindrical features)
        if abs(v1.z - v2.z) < 0.01:
            r1 = (v1.x ** 2 + v1.y ** 2) ** 0.5
            # Chamfer outer edges of body, flange, boss (skip inner edges near shaft)
            if r1 > 8.0:  # skip shaft bore edges
                edges_to_chamfer.append(edge)
    if edges_to_chamfer:
        hub = hub.makeChamfer(CHAMFER_SIZE, edges_to_chamfer)
except Exception as e:
    print(f"  Chamfer warning: {e}")

# Add to document
obj_hub = doc.addObject("Part::Feature", "DriveHub_V2_4_2")
obj_hub.Shape = hub
obj_hub.ViewObject.ShapeColor = (0.85, 0.65, 0.25)  # gold/brass tone
print(f"  Hub body OD:       {HUB_BODY_OD}mm")
print(f"  Hub body height:   {HUB_BODY_H}mm")
print(f"  Flange OD:         {FLANGE_OD}mm")
print(f"  Flange thickness:  {FLANGE_H}mm")
print(f"  Center boss:       D{BOSS_OD}mm x {BOSS_H}mm tall")
print(f"  Total height:      {TOTAL_H + BOSS_H}mm")
print(f"  Shaft bore:        D{SHAFT_BORE}mm")
print(f"  Clamp bolts:       2x M5 at Z={CLAMP_BOLT_Z1}, {CLAMP_BOLT_Z2}mm")
print(f"  Cassette bolts:    {CASSETTE_BOLT_COUNT}x M5 PCD {CASSETTE_BOLT_PCD}mm")
print(f"  Volume:            {hub.Volume:.0f}mm^3")

doc.recompute()

# =============================================================================
# EXPORT STL
# =============================================================================
print(f"\nExporting STL...")
try:
    Part.export([obj_hub], PATH_STL)
    print(f"  [OK] STL: {PATH_STL}")
except Exception as e:
    print(f"  [FAIL] STL export: {e}")

# =============================================================================
# EXPORT PNG
# =============================================================================
print(f"\nExporting PNG view...")
try:
    view = FreeCADGui.activeDocument().activeView()
    view.viewIsometric()
    view.fitAll()
    view.saveImage(PATH_PNG, 1600, 1200, "Current")
    print(f"  [OK] PNG: {PATH_PNG}")
except Exception as e:
    print(f"  [WARN] PNG skipped: {e}")

# =============================================================================
# EXPORT SVG BLUEPRINT
# =============================================================================
print(f"\nGenerating SVG blueprint...")

svg_content = '''<svg viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg" font-family="Arial, sans-serif">
  <rect width="1100" height="800" fill="#fafaf8"/>

  <text x="550" y="32" text-anchor="middle" fill="#1a1a1a" font-size="18" font-weight="bold">DRIVE HUB V2.4.2 -- BLUEPRINT</text>
