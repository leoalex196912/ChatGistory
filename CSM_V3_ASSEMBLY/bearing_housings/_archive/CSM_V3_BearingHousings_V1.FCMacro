  </g>
  <text x="855" y="178" fill="#791F1F" font-size="9">M5 ×4</text>
  <text x="855" y="190" fill="#791F1F" font-size="8">PCD 56</text>
  <!-- Dimensions -->
  <line x1="620" y1="105" x2="900" y2="105" stroke="#9e4818" stroke-width="0.8"/>
  <polygon points="622,105 628,102 628,108" fill="#9e4818"/>
