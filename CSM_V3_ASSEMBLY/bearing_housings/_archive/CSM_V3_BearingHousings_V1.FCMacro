  <!-- Info box BOTTOM -->
  <rect x="560" y="580" width="400" height="95" rx="4" fill="#ffffff" stroke="#D3D1C7" stroke-width="0.5"/>
  <text x="572" y="598" fill="#9e4818" font-size="11" font-weight="bold">BOTTOM block specs:</text>
  <text x="572" y="614" fill="#333" font-size="10">• 2× 6001-2RS stacked (radial, upper pocket)</text>
