print(f"   - NEW PART: Spacer tube (29.40mm length, ID 12.2, OD 18mm)")
print(f"   - Wave spring pocket 1.2 -> 1.4mm (safety margin for assembly)")
print(f"   - Block gap LOCKED at 11mm (6mm Al plate + 5mm clearance)")
print(f"   - Top collar role: RETENTION ONLY (no longer sets preload)")
print(f"\n  CRITICAL DIMENSION:")
print(f"   Spacer tube length: {SPACER_TUBE_LEN}mm +/- {SPACER_TUBE_TOL}mm")
print(f"   This is THE preload-defining number. Deviation tunes preload force:")
print(f"     {SPACER_TUBE_LEN - 0.2}mm = ~50N (too tight, drag)")
print(f"     {SPACER_TUBE_LEN}mm = ~30N (target)")
print(f"     {SPACER_TUBE_LEN + 0.2}mm = ~10N (too loose, click)")
print(f"\n  INHERITED FROM V2.3:")
print(f"   - Wave spring + spacer ring pockets in bottom block")
print(f"\n  INHERITED FROM V2.2:")
print(f"   - TOP pocket 8.8mm (bearing recessed 0.3mm)")
print(f"\n  INHERITED FROM V2.1:")
print(f"   - SLIP_FIT 0.10mm, SHAFT 12.3mm, CSK 3.0mm")
print(f"   - PNG directories fixed, BBox chamfer filter")
print(f"\n  HARDWARE FOR V2.4 ASSEMBLY:")
print(f"   Already own:")
print(f"   - Loctite 603, Koyo AS1226 washers")
print(f"   - 6001-2RS bearings, 51101 thrust bearing")
print(f"   - Clamping shaft collars (12mm) - 2 of 4 used")
print(f"   To order:")
print(f"   - Wave spring (12 ID x 25 OD x 0.45mm) - McMaster ~$10")
print(f"   - Spacer ring (12 ID x 18 OD x 2mm) - McMaster ~$10")
print(f"   To make:")
print(f"   - Spacer tube (PETG print first; aluminum tube ideal)")
print(f"\n  V2.4 ASSEMBLY (SIMPLIFIED - no preload tuning step):")
print(f"   1. Print all 3 STLs (top block, bottom block, spacer tube)")
print(f"   2. Apply Loctite 603, install bearings, cure 24h")
print(f"   3. Stack into bottom block:")
print(f"      lower washers -> thrust bearing -> upper washers")
print(f"      -> wave spring -> spacer ring")
print(f"   4. Install radial bearing (Loctite, cure 24h)")
print(f"   5. Mount blocks on aluminum plate (verify 11mm BLOCK_GAP)")
print(f"   6. Install bottom shaft collar at Z=-2mm (hard stop)")
print(f"   7. Insert shaft through bottom block")
print(f"   8. Slide spacer tube onto shaft above bottom radial inner race")
print(f"   9. Lower top block onto shaft (top bearing slides down onto spacer)")
print(f"  10. Install top shaft collar - LIGHTLY clamp (retention only)")
print(f"\n  TEST PROTOCOL (V2.4 deterministic):")
print(f"   Test 1: Rotation - smooth, slight resistance OK")
print(f"   Test 2: Axial play - pull shaft, ZERO movement allowed")
print(f"   Test 3: Drag - if sticky, spacer too short (-0.1mm shim adjust)")
print(f"   Test 4: Click - if click on rotation, spacer too long (shorten 0.1-0.2mm)")
print(f"   Test 5: Dial indicator - shaft runout <0.2mm TIR at shaft end")
print(f"\n  IF PRELOAD WRONG -- TUNE WITH SHIMS (no reprint needed):")
print(f"   - Add 0.1mm shim BELOW lower washer to INCREASE preload")
print(f"   - Add 0.1mm shim above spacer ring (between ring and inner race)")
print(f"     to DECREASE preload")
print(f"   - Common AS1226 stack adjustment: +/- 0.5mm range available")
print(f"\n  FORCE PATH (V2.4 - geometric preload):")
print(f"   Top block (rigid) holds top bearing")
print(f"     -> top bearing inner race contacts spacer tube")
print(f"       -> spacer tube (29.4mm, rigid)")
print(f"         -> bottom radial bearing inner race")
print(f"           -> spacer ring")
print(f"             -> wave spring (compressed 0.5mm = ~30N)")
print(f"               -> upper washers")
print(f"                 -> thrust bearing (preloaded)")
print(f"                   -> lower washers")
print(f"                     -> PETG floor (rigid)")
print(f"   Result: preload established by SPACER LENGTH, not collar tightness.")
print(f"\n  PRINT SETTINGS:")
print(f"   Blocks:")
print(f"     Material:     PETG (DRY)")
print(f"     Layer:        0.2mm")
print(f"     Perimeters:   5")
print(f"     Top/bottom:   6 solid layers")
print(f"     Infill:       40-50% Gyroid or Cubic")
print(f"     Orientation:  flat on bed, pocket opening UP")
print(f"     Supports:     NONE")
print(f"     Speed:        40mm/s walls, 120mm/s infill")
print(f"   Spacer tube (HIGHER PRECISION REQUIRED):")
print(f"     Layer:        0.1mm (finer for length precision)")
print(f"     Perimeters:   8 (rigidity)")
print(f"     Infill:       100% (solid for deterministic length)")
print(f"     Orientation:  vertical (length axis Z, end faces flat)")
print(f"     Supports:     NONE (hollow tube needs no support)")
print(f"     Top/bottom:   no special - solid throughout")
print(f"     Speed:        30mm/s (slower for accuracy)")
print(f"\n  SPACER TUBE FINAL UPGRADE (recommended):")
print(f"   PETG spacer is OK for prototype testing.")
print(f"   For production, replace with aluminum tube cut to 29.40mm.")
print(f"   Source: Amazon search '18mm OD 12mm ID aluminum tube'")
