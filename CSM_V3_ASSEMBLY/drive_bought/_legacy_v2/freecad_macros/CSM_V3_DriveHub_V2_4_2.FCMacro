  <text x="290" y="92" fill="#1f3a14" font-size="8">(side view)</text>

  <!-- Dimension lines top view -->
  <line x1="100" y1="64" x2="460" y2="64" stroke="#9e6a18" stroke-width="0.8"/>
  <polygon points="102,64 108,61 108,67" fill="#9e6a18"/>
  <polygon points="458,64 452,61 452,67" fill="#9e6a18"/>
