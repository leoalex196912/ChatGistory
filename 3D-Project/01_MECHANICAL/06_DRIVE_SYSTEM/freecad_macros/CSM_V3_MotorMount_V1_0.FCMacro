  <!-- 3 reinforcement ribs (triangles) -->
  <g fill="#c8d4e6" stroke="#3d5a99" stroke-width="1" opacity="0.7">
    <polygon points="916,580 916,480 980,580"/>
    <polygon points="916,580 916,480 980,580"/>
    <polygon points="916,580 916,480 980,580"/>
  </g>
  <text x="965" y="540" fill="#3d5a99" font-size="8">3x ribs</text>
  <text x="965" y="552" fill="#3d5a99" font-size="8">4mm thick</text>
  <text x="965" y="564" fill="#3d5a99" font-size="8">50mm tall x</text>
  <text x="965" y="574" fill="#3d5a99" font-size="8">40mm long</text>

  <!-- Info box -->
  <rect x="40" y="430" width="540" height="320" rx="6" fill="#ffffff" stroke="#D3D1C7" stroke-width="0.8"/>
  <text x="55" y="453" fill="#3d5a99" font-size="13" font-weight="bold">MOTOR MOUNT V1.0 SPECIFICATIONS</text>

  <text x="55" y="475" fill="#9e6a18" font-size="11" font-weight="bold">MOTOR FACE PLATE:</text>
  <text x="55" y="490" fill="#333" font-size="10">- 100x100x8mm thick PETG</text>
  <text x="55" y="503" fill="#333" font-size="10">- D38mm pilot hole (clears 36mm gearbox boss)</text>
  <text x="55" y="516" fill="#333" font-size="10">- 4x M5 round holes at PCD 47 (NEMA 23 pattern)</text>
  <text x="55" y="529" fill="#333" font-size="10">- D10.2x5.5mm counterbore for M5 socket head</text>

  <text x="55" y="551" fill="#9e6a18" font-size="11" font-weight="bold">FOOT (frame interface):</text>
  <text x="55" y="566" fill="#333" font-size="10">- 100x50x8mm thick PETG</text>
  <text x="55" y="579" fill="#333" font-size="10">- 4x slotted holes 30mm long for belt tension</text>
  <text x="55" y="592" fill="#333" font-size="10">- M5 socket head counterbore D10.2x5.5mm</text>
  <text x="55" y="605" fill="#333" font-size="10">- T-nut sliding in 2020 extrusion channel</text>

