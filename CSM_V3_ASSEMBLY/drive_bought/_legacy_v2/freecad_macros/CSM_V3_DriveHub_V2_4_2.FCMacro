print(f"\n{'='*65}")
print(f"COMPLETE -- DRIVE HUB V2.4.2")
print(f"{'='*65}")
print(f"\n  PATH A ARCHITECTURE (no pulley drilling):")
print(f"   Drive hub clamps to shaft INDEPENDENTLY of the pulley.")
print(f"   The 60T HTD 5M pulley sits BELOW the hub on the same shaft,")
print(f"   secured by its OWN set screw (factory standard).")
print(f"   The 4 cassette mount bolts thread UP into M5 inserts in the")
print(f"   cassette base (already designed in cassette parts).")
print(f"\n  HARDWARE - ALL ALREADY OWNED (no new orders needed):")
print(f"   - 2x M5 socket head cap screws ~12mm (clamp bolts)")
print(f"   - 2x M5 hex nuts (clamp nut pockets - press in before assembly)")
print(f"   - 4x M5 flathead countersunk screws ~16mm (cassette mount)")
print(f"   - 4x M5 brass heat-set inserts (in cassette base, future part)")
print(f"   All available in your B0FFSNFK3Y assortment + B0DPQJ4W3Z inserts")
print(f"\n  PRINT SETTINGS:")
print(f"   Material:     PETG (DRY)")
print(f"   Layer height: 0.2mm")
print(f"   Perimeters:   5 (CRITICAL for clamp strength)")
print(f"   Top/bottom:   6 solid layers")
print(f"   Infill:       50% Gyroid (high stiffness)")
print(f"   Orientation:  flange face DOWN on bed")
print(f"                 (smooth top boss = mating surface to cassette)")
print(f"   Supports:     NONE if oriented flange-down")
print(f"   Speed:        40mm/s walls, 100mm/s infill")
print(f"\n  POST-PROCESSING:")
print(f"   1. Test fit on shaft - should slide on with hand pressure")
print(f"      (clamp bolts NOT tight yet - just verify bore sizing)")
print(f"   2. If too tight: ream bore lightly with 12mm reamer or sandpaper")
print(f"   3. Press 2x M5 hex nuts into nut pockets (hex shape captures them)")
print(f"   4. Verify clamp slot is clear (no print artifacts)")
print(f"\n  ASSEMBLY:")
print(f"   1. Insert M5 hex nuts into nut pockets (fit by hand or vise)")
print(f"   2. Slide drive hub onto shaft from cassette side")
print(f"   3. Position hub at correct Z height for cassette to seat properly")
print(f"   4. Tighten 2x M5 clamp bolts to 3-4 Nm (firm but not crushing)")
print(f"   5. Verify shaft cannot rotate independently of hub")
print(f"   6. Bolt cassette base to hub flange (4x M5 flathead from below)")
print(f"\n  TEST PROTOCOL (validates V2.4 preload + drive system):")
print(f"   1. Spin shaft + hub by hand - should rotate smoothly")
print(f"   2. Apply 2-3 kg hanging weight on cassette mount face")
print(f"      (simulates loaded cassette)")
print(f"   3. Spin again - should still rotate smoothly")
print(f"   4. Listen for click/rattle - if any, V2.4 preload is wrong")
print(f"   5. Dial indicator on cassette mounting boss while rotating:")
print(f"      Target: <0.3mm TIR (radial runout at boss surface)")
print(f"   6. If runout >0.5mm, check shaft straightness + bearing alignment")
print(f"\n  WHY THIS PART VALIDATES THE WHOLE PRELOAD CHAIN:")
print(f"   - Loads bearings axially (cassette weight transfers via hub)")
print(f"   - Loads bearings radially (any imbalance amplifies via 90mm flange)")
print(f"   - Tests concentricity of: shaft + bearings + spacer tube + hub")
print(f"   - First chance to catch hidden misalignment BEFORE motor mount")
