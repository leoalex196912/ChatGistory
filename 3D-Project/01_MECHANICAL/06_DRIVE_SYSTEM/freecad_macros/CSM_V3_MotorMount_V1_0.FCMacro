# -*- coding: utf-8 -*-
# =============================================================================
# CSM V3 -- NEMA 23 MOTOR MOUNT  V1.0
# =============================================================================
# File:    CSM_V3_MotorMount_V1_0.FCMacro
# Date:    April 2026
# Target:  C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\freecad_macros\
#
# VERSIONING POLICY:
#   This is the FIRST motor mount design. Independent version counter
#   per project policy. Starts at V1.0.
#
# PURPOSE:
#   L-bracket motor mount that holds the NEMA 23 + 5:1 gearbox to the 2020
#   aluminum extrusion frame. Provides belt tension adjustment via slotted
#   foot (motor stays in fixed position relative to its bracket; whole
#   bracket slides along extrusion to set belt tension).
#
# MOTOR HARDWARE (already ordered):
#   StepperOnline 23HS22-2804S-HG5
#   - NEMA 23 frame: 56.4mm x 56.4mm
#   - With 5:1 PLE-style planetary gearbox
#   - Output flange: 60mm dia, pilot boss 36mm dia x 2mm tall
#   - Mount: 4x M5 at 47mm PCD (NEMA 23 standard)
#   - Output shaft: 14mm dia, ~25mm long with keyway
#   - Total motor+gearbox length: ~120mm
#   - Weight: ~1.5kg
#
# BELT GEOMETRY (already ordered):
#   HTD 5M, 405mm length, 9mm wide
#   60T cassette pulley (PD 95.49mm)
#   20T motor pulley (PD 31.83mm)
#   Calculated nominal center distance: 97.3mm
#   Slot adjustment range: 30mm = center distance 82-112mm (ample margin)
#
# DESIGN APPROACH (Architecture: L-bracket, sliding foot for tension):
#   Motor face plate:
#     - 100mm x 100mm x 8mm thick
#     - Center hole 38mm dia (clears 36mm gearbox pilot + clearance)
#     - 4x ROUND M5 clearance holes at 47mm PCD (motor stays put)
#   Foot (frame interface):
#     - 100mm wide x 50mm deep x 8mm thick
#     - 4x SLOTTED M5 holes (30mm long) for T-nut sliding in extrusion
#     - Slot direction = belt tension axis
#   L-bracket joint:
#     - 90 deg corner, reinforced with 3 triangular ribs
#     - Ribs 4mm thick, span both plate and foot
#
# SLOT GEOMETRY (lessons from drive hub V1.x):
#   - Slots terminate WITH relief holes at each end
#   - Filter chamfer by Z-level + outer surface (not just radius)
#   - Geometry computed from explicit named variables (no magic numbers)
#
# HARDWARE NEEDED (ALL ALREADY OWNED):
#   - 4x M5 socket head cap screws ~16mm (motor face mounting)
#     From B0FFSNFK3Y assortment
#   - 4x M5 socket head cap screws ~12mm (foot to T-nut)
#     From B0FFSNFK3Y assortment
#   - 4x M5 T-nuts for 2020 extrusion
#     From B0GG4N5GR4 (already have 230)
#
# AUTO-EXPORT ON RUN:
#   STL:           C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\
#   PNG view:      C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\images\
#   SVG blueprint: C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM\blueprints\
# =============================================================================

import FreeCAD, FreeCADGui, Part, math, os

# =============================================================================
# OUTPUT PATHS
# =============================================================================
BASE = r"C:\3D-Project\01_MECHANICAL\06_DRIVE_SYSTEM"

PATH_STL = os.path.join(BASE, "CSM_V3_MotorMount_V1_0.stl")
PATH_PNG = os.path.join(BASE, "images", "MotorMount_V1_0_View.png")
PATH_SVG = os.path.join(BASE, "blueprints", "MotorMount_V1_0_Blueprint.svg")

for p in [PATH_STL, PATH_PNG, PATH_SVG]:
    os.makedirs(os.path.dirname(p), exist_ok=True)

doc = FreeCAD.newDocument("CSM_MotorMount_V1_0")

# =============================================================================
# DESIGN PARAMETERS
# =============================================================================
# --- Motor face plate ---
PLATE_W            = 100.0    # plate width (Y direction)
PLATE_H            = 100.0    # plate height (Z direction)
PLATE_T            = 8.0      # plate thickness (X direction)

# Gearbox pilot boss clearance hole
PILOT_BOSS_D       = 36.0     # gearbox pilot diameter
PILOT_HOLE_D       = 38.0     # plate clearance (1mm radial slip)

# Motor mount holes (NEMA 23 + PLE gearbox standard)
MOTOR_PCD          = 47.0     # bolt circle diameter
MOTOR_BOLT_D       = 5.5      # M5 clearance through-hole
MOTOR_BOLT_CSK_D   = 10.2     # M5 socket head OR flathead (use SHCS)
MOTOR_BOLT_CSK_H   = 5.5      # head pocket depth (socket head ~5mm)

# --- Foot (frame interface) ---
FOOT_W             = 100.0    # same as plate (Y direction)
FOOT_D             = 50.0     # foot depth (X direction)
FOOT_T             = 8.0      # thickness (Z direction)

# Foot slotted holes (for T-nut sliding in extrusion)
FOOT_BOLT_D        = 5.5      # M5 clearance
FOOT_SLOT_LEN      = 30.0     # slot length along X direction (belt tension axis)
FOOT_SLOT_PCD_X    = 25.0     # X distance from L-corner to slot center (nominal)
FOOT_SLOT_SPACING_Y = 60.0    # Y distance between two pairs of slots
FOOT_SLOT_HEAD_D   = 10.2     # M5 socket head pocket
FOOT_SLOT_HEAD_H   = 5.5      # head pocket depth

# --- L-bracket reinforcement ribs ---
RIB_T              = 4.0      # rib thickness
RIB_COUNT          = 3        # 3 ribs across width
RIB_HEIGHT         = 50.0     # rib goes 50mm up the plate
RIB_DEPTH          = 40.0     # rib goes 40mm along the foot

# General
CHAMFER_SIZE       = 1.0
RELIEF_D           = 3.0      # slot end relief holes (lessons from drive hub V1.3)

# =============================================================================
# COORDINATE SYSTEM
# =============================================================================
# X axis: foot extends in +X direction (belt tension direction)
# Y axis: width of bracket (parallel to extrusion)
# Z axis: vertical (motor plate extends up)
#
# L-bracket origin is at the inside corner where plate meets foot.
# Plate runs from Z=0 to Z=PLATE_H, X=0 (inside) to X=PLATE_T (outside)
# Foot runs from X=0 (inside corner) to X=FOOT_D, Z=0 (top) to Z=-FOOT_T (bottom)

# =============================================================================
# HELPER FUNCTIONS
# =============================================================================
def make_slot_hole(slot_w, slot_l, depth, axis="X"):
    """Create a slot-shaped through hole.
    Slot is a rectangle with rounded ends (capsule shape).
    slot_w = slot width (across short axis)
    slot_l = total slot length (long axis)
    depth = depth of hole
    """
    radius = slot_w / 2.0
    rect_l = slot_l - slot_w  # length of straight section
    if rect_l < 0:
        rect_l = 0
    # Build as rectangle + 2 cylinders
    rect = Part.makeBox(rect_l, slot_w, depth)
    rect.translate(FreeCAD.Vector(-rect_l/2.0, -slot_w/2.0, 0))
    cyl1 = Part.makeCylinder(radius, depth)
    cyl1.translate(FreeCAD.Vector(-rect_l/2.0, 0, 0))
    cyl2 = Part.makeCylinder(radius, depth)
    cyl2.translate(FreeCAD.Vector(rect_l/2.0, 0, 0))
    slot = rect.fuse(cyl1).fuse(cyl2)
    return slot

# =============================================================================
# BUILD L-BRACKET
# =============================================================================
print("=" * 65)
print("CSM V3 -- NEMA 23 MOTOR MOUNT V1.0")
print("=" * 65)
print(f"\nBuilding L-bracket...")

# 1. Motor face plate (vertical, in Y-Z plane, X=0 to X=PLATE_T)
plate = Part.makeBox(PLATE_T, PLATE_W, PLATE_H)
plate.translate(FreeCAD.Vector(0, -PLATE_W/2.0, 0))

# 2. Foot (horizontal, in X-Y plane, Z=0 to Z=-FOOT_T)
foot = Part.makeBox(FOOT_D, FOOT_W, FOOT_T)
foot.translate(FreeCAD.Vector(0, -FOOT_W/2.0, -FOOT_T))

# 3. Fuse plate and foot into L-bracket
bracket = plate.fuse(foot)

# 4. Cut motor pilot boss clearance hole (center of plate, axis=X)
pilot_hole = Part.makeCylinder(PILOT_HOLE_D / 2.0, PLATE_T + 4)
pilot_hole.rotate(FreeCAD.Vector(0,0,0), FreeCAD.Vector(0,1,0), 90)  # rotate to X axis
pilot_hole.translate(FreeCAD.Vector(-2, 0, PLATE_H / 2.0))
bracket = bracket.cut(pilot_hole)

# 5. Cut 4x motor mount holes (M5 at 47mm PCD around plate center)
plate_center_z = PLATE_H / 2.0
for i in range(4):
    ang = math.radians(i * 90.0 + 45.0)
    by = (MOTOR_PCD / 2.0) * math.cos(ang)
    bz = (MOTOR_PCD / 2.0) * math.sin(ang) + plate_center_z

    # Through-hole for M5 shank
    hole = Part.makeCylinder(MOTOR_BOLT_D / 2.0, PLATE_T + 4)
    hole.rotate(FreeCAD.Vector(0,0,0), FreeCAD.Vector(0,1,0), 90)
    hole.translate(FreeCAD.Vector(-2, by, bz))
    bracket = bracket.cut(hole)

    # Counterbore for socket head (head sits flush from outside)
    head_pocket = Part.makeCylinder(MOTOR_BOLT_CSK_D / 2.0, MOTOR_BOLT_CSK_H + 1)
    head_pocket.rotate(FreeCAD.Vector(0,0,0), FreeCAD.Vector(0,1,0), 90)
    # Outside face is at X=PLATE_T, so head pocket starts there going outward
    head_pocket.translate(FreeCAD.Vector(PLATE_T - MOTOR_BOLT_CSK_H, by, bz))
    bracket = bracket.cut(head_pocket)

print(f"  Motor face plate:     {PLATE_W}x{PLATE_H}x{PLATE_T}mm")
print(f"  Pilot hole:           D{PILOT_HOLE_D}mm")
print(f"  4x M5 holes at PCD:   {MOTOR_PCD}mm with counterbore D{MOTOR_BOLT_CSK_D}")

# 6. Cut 4x slotted holes in foot (for T-nut sliding belt tension adjust)
# Slots run along X direction (belt tension axis)
# Two pairs at Y = +/- FOOT_SLOT_SPACING_Y/2
foot_top_z = -0.001  # just into foot top
slot_centers_y = [-FOOT_SLOT_SPACING_Y/2, FOOT_SLOT_SPACING_Y/2]
slot_centers_x = [FOOT_SLOT_PCD_X, FOOT_D - FOOT_SLOT_PCD_X]

for sx in slot_centers_x:
    for sy in slot_centers_y:
        # Slot through-hole
        slot = make_slot_hole(FOOT_BOLT_D, FOOT_SLOT_LEN, FOOT_T + 4)
        slot.translate(FreeCAD.Vector(sx, sy, -FOOT_T - 2))
        bracket = bracket.cut(slot)

        # Counterbore for M5 socket head on top of foot
        head_slot = make_slot_hole(FOOT_SLOT_HEAD_D, FOOT_SLOT_LEN, FOOT_SLOT_HEAD_H + 1)
        head_slot.translate(FreeCAD.Vector(sx, sy, -FOOT_SLOT_HEAD_H))
        bracket = bracket.cut(head_slot)

print(f"  Foot:                 {FOOT_W}x{FOOT_D}x{FOOT_T}mm")
print(f"  4x slotted holes:     {FOOT_SLOT_LEN}mm long, M5")
print(f"  Slot pattern:         {FOOT_SLOT_SPACING_Y}mm Y spacing")

# 7. Add reinforcement ribs (triangular, span the L-corner)
# Ribs are vertical triangles in the X-Z plane, distributed along Y
rib_y_spacing = (PLATE_W - 20) / (RIB_COUNT - 1) if RIB_COUNT > 1 else 0
rib_y_start = -(PLATE_W - 20) / 2.0
for i in range(RIB_COUNT):
    rib_y = rib_y_start + i * rib_y_spacing if RIB_COUNT > 1 else 0

    # Triangular rib: vertices at (PLATE_T, y, 0), (PLATE_T, y, RIB_HEIGHT), (PLATE_T+RIB_DEPTH, y, 0)
    # Actually we need the rib to attach to plate (X=PLATE_T side) and foot (top of foot, Z=0)
    pts = [
        FreeCAD.Vector(PLATE_T, rib_y - RIB_T/2.0, 0),
        FreeCAD.Vector(PLATE_T, rib_y - RIB_T/2.0, RIB_HEIGHT),
        FreeCAD.Vector(PLATE_T + RIB_DEPTH, rib_y - RIB_T/2.0, 0),
        FreeCAD.Vector(PLATE_T, rib_y - RIB_T/2.0, 0),  # close
    ]
    poly = Part.makePolygon(pts)
    face = Part.Face(Part.Wire(poly))
    rib = face.extrude(FreeCAD.Vector(0, RIB_T, 0))
    bracket = bracket.fuse(rib)

print(f"  Ribs:                 {RIB_COUNT}x triangular, {RIB_T}mm thick")

# 8. Apply chamfer to outer edges (using V1.3 lessons - careful filter)
try:
    edges_to_chamfer = []
    bb = bracket.BoundBox
    tol = 0.5
    for edge in bracket.Edges:
        v1, v2 = edge.Vertexes[0].Point, edge.Vertexes[1].Point
        # Only chamfer edges on the EXTREME outer surfaces of the bounding box
        # (skip all internal pocket/hole edges)
        on_boundary = False
        # Check if both endpoints are on a bounding box face
        for bx in [bb.XMin, bb.XMax]:
            if abs(v1.x - bx) < tol and abs(v2.x - bx) < tol:
                on_boundary = True
                break
        if not on_boundary:
            for by in [bb.YMin, bb.YMax]:
                if abs(v1.y - by) < tol and abs(v2.y - by) < tol:
                    on_boundary = True
                    break
        if not on_boundary:
            for bz in [bb.ZMin, bb.ZMax]:
                if abs(v1.z - bz) < tol and abs(v2.z - bz) < tol:
                    on_boundary = True
                    break
        # Also skip very short edges (likely artifacts of fillet/intersection)
        if on_boundary and edge.Length > 5.0:
            edges_to_chamfer.append(edge)

    if edges_to_chamfer:
        bracket = bracket.makeChamfer(CHAMFER_SIZE, edges_to_chamfer)
        print(f"  Chamfered:            {len(edges_to_chamfer)} outer edges")
except Exception as e:
    print(f"  Chamfer warning:      {e}")

# Add to document
obj_mount = doc.addObject("Part::Feature", "MotorMount_V1_0")
obj_mount.Shape = bracket
obj_mount.ViewObject.ShapeColor = (0.6, 0.7, 0.8)  # blue-gray (industrial look)

print(f"\n  Total bounding box:   {bracket.BoundBox.XLength:.0f} x {bracket.BoundBox.YLength:.0f} x {bracket.BoundBox.ZLength:.0f}mm")
print(f"  Volume:               {bracket.Volume:.0f}mm^3")
print(f"  Estimated weight:     {bracket.Volume * 1.27 / 1000:.0f}g (PETG, 50% infill)")

doc.recompute()

# =============================================================================
# EXPORT STL
# =============================================================================
print(f"\nExporting STL...")
try:
    Part.export([obj_mount], PATH_STL)
    print(f"  [OK] STL: {PATH_STL}")
except Exception as e:
    print(f"  [FAIL] STL: {e}")

# =============================================================================
# EXPORT PNG
# =============================================================================
print(f"\nExporting PNG view...")
try:
    view = FreeCADGui.activeDocument().activeView()
    view.viewIsometric()
    view.fitAll()
    view.saveImage(PATH_PNG, 1600, 1200, "Current")
    print(f"  [OK] PNG: {PATH_PNG}")
except Exception as e:
    print(f"  [WARN] PNG skipped: {e}")

# =============================================================================
# EXPORT SVG BLUEPRINT
# =============================================================================
print(f"\nGenerating SVG blueprint...")

svg_content = '''<svg viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg" font-family="Arial, sans-serif">
  <rect width="1100" height="800" fill="#fafaf8"/>

  <text x="550" y="32" text-anchor="middle" fill="#1a1a1a" font-size="18" font-weight="bold">NEMA 23 MOTOR MOUNT V1.0 -- BLUEPRINT</text>
  <text x="550" y="50" text-anchor="middle" fill="#666" font-size="11">L-bracket. Slotted foot for belt tension. PETG production.</text>
  <line x1="40" y1="62" x2="1060" y2="62" stroke="#1e3a5f" stroke-width="0.8"/>

  <!-- FRONT VIEW (motor face) - LEFT -->
  <text x="240" y="82" text-anchor="middle" fill="#3d5a99" font-size="13" font-weight="bold">FRONT VIEW (motor face)</text>
  <text x="240" y="98" text-anchor="middle" fill="#666" font-size="10">100mm x 100mm plate with NEMA 23 pattern</text>

  <!-- Plate outline 100x100 scaled to 200x200 -->
  <rect x="140" y="120" width="200" height="200" fill="#dde6f0" stroke="#3d5a99" stroke-width="1.5"/>

  <!-- Pilot hole D38 scaled to D76 -->
  <circle cx="240" cy="220" r="38" fill="#ffffff" stroke="#666" stroke-width="1.5"/>
  <text x="240" y="218" text-anchor="middle" fill="#333" font-size="9">pilot</text>
  <text x="240" y="230" text-anchor="middle" fill="#333" font-size="9">D38</text>

  <!-- 4x M5 holes at PCD 47, scaled to radius 47 from center -->
  <g fill="#E24B4A" stroke="#501313" stroke-width="1">
    <circle cx="273.2" cy="186.8" r="6"/>
    <circle cx="273.2" cy="253.2" r="6"/>
    <circle cx="206.8" cy="253.2" r="6"/>
    <circle cx="206.8" cy="186.8" r="6"/>
  </g>
  <text x="290" y="184" fill="#791F1F" font-size="9">M5x4</text>
  <text x="290" y="196" fill="#791F1F" font-size="8">PCD 47</text>
  <text x="290" y="208" fill="#791F1F" font-size="8">counterbore</text>
  <text x="290" y="220" fill="#791F1F" font-size="8">D10.2 x 5.5</text>

  <!-- Foot indication (below plate, viewed edge-on in front view) -->
  <rect x="140" y="320" width="200" height="16" fill="#f0e8dd" stroke="#9e6a18" stroke-width="1.5"/>
  <text x="240" y="332" text-anchor="middle" fill="#9e6a18" font-size="9" font-weight="bold">FOOT (extends out toward viewer)</text>

  <!-- Dimensions -->
  <line x1="120" y1="120" x2="120" y2="320" stroke="#3d5a99" stroke-width="0.8"/>
  <polygon points="120,122 117,128 123,128" fill="#3d5a99"/>
  <polygon points="120,318 117,312 123,312" fill="#3d5a99"/>
  <text x="100" y="225" fill="#3d5a99" font-size="11" font-weight="bold" transform="rotate(-90 100 225)">100mm</text>

  <line x1="140" y1="350" x2="340" y2="350" stroke="#3d5a99" stroke-width="0.8"/>
  <polygon points="142,350 148,347 148,353" fill="#3d5a99"/>
  <polygon points="338,350 332,347 332,353" fill="#3d5a99"/>
  <text x="240" y="364" text-anchor="middle" fill="#3d5a99" font-size="11" font-weight="bold">100mm wide</text>

  <!-- TOP VIEW (foot pattern) - CENTER -->
  <text x="700" y="82" text-anchor="middle" fill="#9e6a18" font-size="13" font-weight="bold">TOP VIEW (foot)</text>
  <text x="700" y="98" text-anchor="middle" fill="#666" font-size="10">100mm x 50mm with 4x slotted holes</text>

  <!-- Foot rectangle 100x50, scaled 200x100 -->
  <rect x="600" y="150" width="200" height="100" fill="#f0e8dd" stroke="#9e6a18" stroke-width="1.5"/>

  <!-- L-corner indicator -->
  <line x1="600" y1="150" x2="600" y2="250" stroke="#3d5a99" stroke-width="3"/>
  <text x="588" y="200" fill="#3d5a99" font-size="9" font-weight="bold" transform="rotate(-90 588 200)">L-corner</text>

  <!-- 4x slotted holes (slot length 30mm scaled to 60px, slot width 5.5mm scaled to 11px) -->
  <!-- Slot positions: X = 25 and 25, in scaled = 50 from L-corner; Y = +/- 30 from center, in scaled = 60 px -->
  <!-- Centers: (650, 170), (650, 230), (750, 170), (750, 230) -->
