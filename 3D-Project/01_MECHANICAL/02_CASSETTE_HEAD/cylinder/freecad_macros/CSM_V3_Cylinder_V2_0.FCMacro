print()
print("Z-AXIS LAYOUT:")
print(f"  Z=75.0  TOP (chamfer {EDGE_CHAMFER}mm)")
print(f"  Z=63.6  Spring groove TOP")
print(f"  Z=62.0  Spring center (FlyDesigns 0.110\")")
print(f"  Z=60.4  Spring groove BOTTOM  (depth {SPRING_GROOVE_DEPTH}mm)")
print(f"  Z=23.0  Slot bottom  →  Z=75 = 52mm slot zone")
print(f"  Z=23.0  Butt cavity TOP  (cam ring engagement)")
print(f"  Z=19.0  Butt cavity BOTTOM")
print(f"  Z= 3.0  Hub pocket BOTTOM  (D{HUB_POCKET_D}×3mm)")
print(f"  Z= 0.0  BOTTOM")
print()
print("WHAT TO PRINT FIRST:  CSM_V3_Cylinder_V2_0_TESTWEDGE.stl")
print("  30-45 min · ~10g PETG · same settings as full cylinder")
print("  Test fit with 12G FlyDesigns needle in each slot:")
for i, w in enumerate(WEDGE_SLOT_WIDTHS):
    tag = " ← TARGET" if w == 1.22 else ""
    print(f"    Slot {i+1}: {w}mm{tag}")
print("  Choose the width that slides smoothly without rattle.")
