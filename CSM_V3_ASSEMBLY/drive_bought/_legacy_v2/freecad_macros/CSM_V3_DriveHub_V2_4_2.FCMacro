  <text x="280" y="285" text-anchor="middle" fill="#993556" font-size="9">D12.15</text>

  <!-- 4 cassette bolts at PCD 70mm -->
  <g fill="#E24B4A" stroke="#501313" stroke-width="1">
    <!-- 45 deg offset, PCD 70mm scaled to 140 radius -->
    <circle cx="379" cy="181" r="9"/>
    <circle cx="379" cy="379" r="9"/>
    <circle cx="181" cy="379" r="9"/>
    <circle cx="181" cy="181" r="9"/>
  </g>
  <text x="395" y="178" fill="#791F1F" font-size="10">M5 x4</text>
  <text x="395" y="190" fill="#791F1F" font-size="9">PCD 70</text>
