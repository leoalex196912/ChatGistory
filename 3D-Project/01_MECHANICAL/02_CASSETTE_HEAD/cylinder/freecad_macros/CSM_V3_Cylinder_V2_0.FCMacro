print("  Infill speed:  80 mm/s")
print("  Time:          4-6 hours  (~120g PETG)")
print()
print("FILES GENERATED:")
print(f"  STL FULL:    {PATH_STL_FULL}")
print(f"  STL WEDGE:   {PATH_STL_WEDGE}")
if png_ok:
    print(f"  PNGs (4):    {os.path.dirname(PATH_PNG_FULL_ISO)}")
else:
    print(f"  PNGs:        not generated (run from FreeCAD GUI)")
print(f"  SVG:         {PATH_SVG}")
