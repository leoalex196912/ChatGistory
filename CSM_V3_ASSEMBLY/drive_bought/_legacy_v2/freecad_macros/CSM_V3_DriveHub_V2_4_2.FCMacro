  </g>
  <text x="630" y="155" fill="#791F1F" font-size="9" text-anchor="end">M5 thru</text>
  <!-- Countersinks on flange bottom -->
  <polygon points="672,165 680,165 676,159" fill="#E24B4A" opacity="0.6"/>
  <polygon points="920,165 928,165 924,159" fill="#E24B4A" opacity="0.6"/>
  <text x="630" y="178" fill="#791F1F" font-size="8" text-anchor="end">90 CSK</text>

  <!-- Below hub: 60T pulley indication -->
  <line x1="700" y1="219" x2="900" y2="219" stroke="#666" stroke-width="0.5" stroke-dasharray="2,2"/>
