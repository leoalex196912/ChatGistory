  <!-- Clamp bolt 2 (Z=13mm from bottom) -->
  <rect x="700" y="184" width="200" height="5" fill="none" stroke="#5a8d3e" stroke-width="1" stroke-dasharray="2,2"/>
  <text x="910" y="189" fill="#1f3a14" font-size="9">M5 clamp #2</text>
  <text x="910" y="199" fill="#1f3a14" font-size="8">(Z=13)</text>

  <!-- Cassette mount bolts (vertical, threading UP from below) -->
  <g fill="#E24B4A" stroke="#501313" stroke-width="0.8">
    <rect x="675" y="140" width="3" height="25"/>
