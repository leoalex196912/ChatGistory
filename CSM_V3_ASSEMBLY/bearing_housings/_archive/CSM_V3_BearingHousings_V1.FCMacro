  <text x="500" y="110" text-anchor="middle" fill="#1a1a1a" font-size="11" font-weight="bold">ASSEMBLY</text>

  <!-- Simplified assembly schematic -->
  <g transform="translate(500,120)">
    <!-- Top plate -->
    <rect x="-50" y="0" width="100" height="6" fill="#c0c0c0" stroke="#666" stroke-width="1"/>
    <text x="55" y="5" fill="#666" font-size="8">Al plate 6mm</text>
    <!-- Top block -->
    <rect x="-30" y="6" width="60" height="20" fill="#d8e8f5" stroke="#184e9e" stroke-width="1"/>
    <circle cx="0" cy="16" r="14" fill="none" stroke="#999" stroke-width="0.8"/>
    <text x="35" y="20" fill="#184e9e" font-size="8">TOP</text>
    <!-- Shaft -->
    <rect x="-3" y="6" width="6" height="350" fill="#ddd" stroke="#666" stroke-width="0.5"/>
