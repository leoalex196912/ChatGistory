# -*- coding: utf-8 -*-
# =============================================================================
# CSM V3 -- BEARING HOUSING BLOCKS  V2.4
# =============================================================================
# File:    CSM_V3_BearingHousings_V2_4.FCMacro
# Date:    April 2026
# Target:  C:\3D-Project\01_MECHANICAL\05_BEARINGS_SHAFT\freecad_macros\
#
# PHILOSOPHY SHIFT (V2.4):
#   V2.3: preload set by tightening top collar at Z=59mm (HUMAN ADJUSTMENT)
#   V2.4: preload set by spacer tube length 29.4mm (DETERMINISTIC GEOMETRY)
#
#   This is how industrial machines work. CNC spindles, knitting heads,
#   precision gearboxes -- all use rigid spacer tubes that lock the
#   bearing-to-bearing distance. The wave spring is over-filled by exactly
#   0.5mm, forcing geometric compression to ~30N preload regardless of
#   how tight the collars are.
#
#   Result: collars become RETENTION ONLY. They prevent the shaft from
#   sliding axially out of the housing but do NOT create or set preload.
#
# CHANGES FROM V2.3:
#   V2.4-A: NEW PART -- Spacer tube modeled in macro
#           Length: 29.40mm nominal +/- 0.05mm
#           ID: 12.2mm (slip on 12mm shaft)
#           OD: 18mm (clears bearing OD, sits on inner race)
#           Material: PETG print first; upgrade to aluminum/steel later
#   V2.4-B: Spring pocket depth 1.2 -> 1.4mm
#           Provides 0.2mm safety margin so spring doesn't preload
#           accidentally during dry-fit assembly checks
#   V2.4-C: BLOCK_GAP locked at 11.0mm
#           This is the distance between top of bottom block and bottom
#           of top block. Critical because spacer length depends on it.
#           Made up of: 6mm aluminum plate + 5mm assembly clearance.
#
# SPACER LENGTH MATH (validated, do not modify without recalculating):
#   Bottom radial bearing top face (inner race): Z = 27.4mm
#   Top bearing bottom face (inner race) with 11mm block gap: Z = 57.7mm
#   Distance between inner races: 30.3mm
#   Required preload compression: 0.5mm of wave spring
#   Spacer length: 30.3 - 0.5 - 0.4 (tolerance margin) = 29.40mm
#
# COLLAR POSITIONING (V2.4 - SIMPLIFIED):
#   Bottom collar: Z = -2mm (hard stop only, prevents shaft falling out)
#   Top collar: lightly clamped after assembly (RETENTION ONLY)
#   No specific Z position required for top collar -- preload is
#   established by spacer tube geometry, not collar position.
#
# CHANGES INHERITED:
#   V2.3: Wave spring + spacer ring pockets in bottom block
#   V2.2: TOP block bearing pocket recessed 0.3mm
#   V2.1: SLIP_FIT 0.10mm, SHAFT 12.3mm, CSK 3.0mm, BBox chamfer
#
# OUTPUT FILES (V2.4 generates THREE STL files now):
#   - CSM_V3_BearingHousing_TOP_V2_4.stl
#   - CSM_V3_BearingHousing_BOTTOM_V2_4.stl
#   - CSM_V3_SpacerTube_V2_4.stl  [NEW]
#   - PAIR + spacer combined assembly STL
#
# WAVE SPRING SPEC (unchanged from V2.3):
#   Type: single-turn 3-wave disc washer (NOT multi-turn)
#   12mm ID x 25mm OD x 0.45mm thick, 17-7PH stainless
#   ~30N at 1mm compression (validated)
#   Source: McMaster-Carr or Enduro Bearings WA Wave 12/0.4
#
# SPACER RING SPEC (in bottom block, unchanged from V2.3):
#   12mm ID x 18mm OD x 2mm thick, 18-8 stainless
#   Source: McMaster-Carr metric round shim
#
# SPACER TUBE PRINT/MACHINING NOTES:
#   - Print PETG first to validate geometry (~$0)
#   - For final: have machined from aluminum tube (~$10) or
#     use 18mm OD aluminum tube cut to 29.40mm with mill/lathe
#   - Tolerance critical: +/- 0.05mm length
#   - If too long: spacer hits both races, spring unloaded -> click
#   - If too short: too much preload -> drag, heat
#   - Tune with 0.1mm shim washers if needed (no reprint required)
#
# KEPT FROM V2 (all correct, all validated):
#   - Slip fit + Loctite 603 (not press fit)
#   - Natural retaining shoulder at pocket bottom (shaft bore step)
#   - Steel thrust washer pockets (2x, above + below 51101)
#   - ONE radial bearing per block (not 2 stacked)
#   - Proper 90 degree conical countersinks (Part.makeCone)
#   - 80x80x35mm bottom block (larger than V1)
#   - Outer edges chamfered 1mm
#
# REJECTED REVIEW SUGGESTIONS (analyzed and declined):
#   - "Pocket 7.7mm deep to make bearing stick out 0.3mm" -- this does
#     NOT create axial retention (nothing presses down from above).
#     Loctite 603 shear strength 12000N is adequate for our load case
#     which has zero upward axial force on either radial bearing.
#   - "Anti-rotation flats/ribs" -- overengineered for Loctite 603's
#     shear strength vs actual friction torque (6+ orders of magnitude
#     margin). Skipped.
#
# BEARINGS USED:
#   6001-2RS:  OD 28mm  ID 12mm  Width 8mm
#   51101:     OD 26mm  ID 12mm  Height 9mm
#   Koyo AS1226 washer: 12mm ID  26mm OD  1mm thick  (use 2 stacked per
#                                                      side for 2mm total)
# =============================================================================

import FreeCAD, FreeCADGui, Part, math, os

# =============================================================================
# OUTPUT PATHS (V2.1-A: all paths now create directories)
# =============================================================================
BASE = r"C:\3D-Project\01_MECHANICAL\05_BEARINGS_SHAFT"

PATH_STL_TOP    = os.path.join(BASE, "CSM_V3_BearingHousing_TOP_V2_4.stl")
PATH_STL_BOT    = os.path.join(BASE, "CSM_V3_BearingHousing_BOTTOM_V2_4.stl")
PATH_STL_PAIR   = os.path.join(BASE, "CSM_V3_BearingHousings_PAIR_V2_4.stl")
PATH_STL_SPACER = os.path.join(BASE, "CSM_V3_SpacerTube_V2_4.stl")  # V2.4 NEW
PATH_PNG_TOP    = os.path.join(BASE, "images", "BearingHousing_TOP_V2_4_View.png")
PATH_PNG_BOT    = os.path.join(BASE, "images", "BearingHousing_BOTTOM_V2_4_View.png")
PATH_PNG_BOTH   = os.path.join(BASE, "images", "BearingHousings_V2_4_Both_View.png")
PATH_SVG        = os.path.join(BASE, "blueprints", "BearingHousings_V2_4_Blueprint.svg")

# V2.1-A FIX: all PNG + SVG paths now in the makedirs loop
# V2.4: spacer STL path added
for p in [PATH_STL_TOP, PATH_STL_BOT, PATH_STL_PAIR, PATH_STL_SPACER,
          PATH_PNG_TOP, PATH_PNG_BOT, PATH_PNG_BOTH, PATH_SVG]:
    os.makedirs(os.path.dirname(p), exist_ok=True)

doc = FreeCAD.newDocument("CSM_BearingHousings_V2_4")

# =============================================================================
# BEARING SPECIFICATIONS
# =============================================================================
BEARING_OD      = 28.0    # 6001-2RS outer
BEARING_ID      = 12.0    # 6001-2RS inner
BEARING_W       = 8.0     # 6001-2RS width

THRUST_OD       = 26.0    # 51101 outer
THRUST_ID       = 12.0    # 51101 inner
THRUST_H        = 9.0     # 51101 height

# Koyo AS1226 washer: 1mm thick - we stack 2 for 2mm effective thickness
WASHER_OD        = 26.0
WASHER_T_STACKED = 2.0    # 2x 1mm washers stacked

# V2.3: Wave spring specifications
SPRING_OD        = 25.0   # spring outer diameter
SPRING_POCKET_D  = 26.3   # pocket diameter (matches thrust/washer pockets)
SPRING_POCKET_H  = 1.4    # V2.4: increased from 1.2 for safety margin
# At ~0.5mm compression, spring force is ~30N (validated against Smalley data)
# 1.4mm pocket prevents accidental preload during dry-fit assembly checks

# V2.3: Spacer ring specifications (sits above spring, below radial bearing)
SPACER_ID        = 12.0   # slip fit on shaft
SPACER_OD        = 18.0   # smaller than bearing OD, protects inner race only
SPACER_POCKET_D  = 26.3   # same pocket diameter for consistent stack
SPACER_POCKET_H  = 2.0    # spacer thickness (2mm)

# V2.4 NEW: Block gap and spacer tube specifications
# CRITICAL: these dimensions are interdependent and must match
BLOCK_GAP            = 11.0    # mm between top of bottom block and bottom of top block
                               # (6mm aluminum plate + 5mm assembly clearance)
SPACER_TUBE_ID       = 12.2    # slip fit on shaft
SPACER_TUBE_OD       = 18.0    # clears bearing OD, contacts inner race
SPACER_TUBE_LEN      = 29.40   # CRITICAL: defines preload geometrically
SPACER_TUBE_TOL      = 0.05    # +/- tolerance on spacer length
# Math: distance between bearing inner races = 30.3mm
#       Spring compression target = 0.5mm
#       Tolerance margin = 0.4mm
#       Spacer length = 30.3 - 0.5 - 0.4 = 29.40mm

SHAFT_D         = 12.0    # main shaft diameter

# =============================================================================
# FIT TOLERANCES (V2.1-B, C, D)
# =============================================================================
SHAFT_CLEAR     = 12.3    # V2.1-C: was 12.5 (tighter clearance, still safe)
SLIP_FIT        = 0.10    # V2.1-B: was 0.05 (realistic for PETG FDM)
POCKET_SLIP     = 0.30    # thrust bearing pocket clearance (unchanged)

CSK_DEPTH       = 3.0     # V2.1-D: was 2.8 (ensures head flush)

# =============================================================================
# TOP BLOCK PARAMETERS
# =============================================================================
TOP_W           = 60.0
TOP_D           = 60.0
TOP_H           = 20.0
TOP_BEARING_POCKET_D = BEARING_OD + SLIP_FIT   # 28.10mm
TOP_BEARING_POCKET_H = BEARING_W + 0.8         # V2.2: 8.8mm (bearing recessed 0.3mm)
TOP_BOLT_PCD    = 48.0
TOP_BOLT_D      = 5.5     # M5 clearance
TOP_BOLT_CS_D_TOP = 10.0  # countersink top diameter (M5 head flush)

# =============================================================================
# BOTTOM BLOCK PARAMETERS
# =============================================================================
BOT_W           = 80.0
BOT_D           = 80.0
BOT_H           = 35.0

BOT_FLOOR_H     = 3.0
BOT_WASHER_POCKET_D = WASHER_OD + POCKET_SLIP  # 26.3mm
BOT_THRUST_POCKET_D = THRUST_OD + POCKET_SLIP  # 26.3mm
BOT_RADIAL_POCKET_D = BEARING_OD + SLIP_FIT    # 28.10mm
BOT_RADIAL_POCKET_H = BEARING_W + 0.5          # 8.5mm

BOT_BOLT_PCD    = 64.0
BOT_BOLT_D      = 5.5
BOT_BOLT_CS_D_TOP = 10.0

CHAMFER_SIZE    = 1.0

# =============================================================================
# HELPER FUNCTIONS
# =============================================================================
def make_countersink_cone(r_bottom, r_top, height):
    """Proper 90 degree cone for M5 flathead countersink."""
    return Part.makeCone(r_bottom, r_top, height)

def apply_outer_chamfer(shape, size):
    """V2.1-E: Chamfer only outer perimeter vertical edges.
    Uses bounding box proximity check so internal edges (pocket walls,
    shaft bore) are never accidentally chamfered even if geometry changes.
    """
    try:
        bb = shape.BoundBox
        tol = 0.1  # 0.1mm tolerance for 'on the perimeter' test
        edges_to_chamfer = []
        for edge in shape.Edges:
            v1, v2 = edge.Vertexes[0].Point, edge.Vertexes[1].Point
            # Must be a vertical edge (parallel to Z)
            if abs(v1.z - v2.z) < 1.0:
                continue
            # Must lie on the outer perimeter (X or Y at the bounding box limit)
            on_perimeter = (
                abs(v1.x - bb.XMin) < tol or abs(v1.x - bb.XMax) < tol or
                abs(v1.y - bb.YMin) < tol or abs(v1.y - bb.YMax) < tol
            )
            if on_perimeter:
                edges_to_chamfer.append(edge)
        if edges_to_chamfer:
            return shape.makeChamfer(size, edges_to_chamfer)
        return shape
    except Exception as e:
        print(f"  Chamfer skipped: {e}")
        return shape

# =============================================================================
# BUILD TOP BLOCK
# =============================================================================
print("=" * 65)
print("CSM V3 -- BEARING HOUSING BLOCKS V2.4")
print("=" * 65)
print(f"\n[1/3] Building TOP block...")

top = Part.makeBox(TOP_W, TOP_D, TOP_H)
top.translate(FreeCAD.Vector(-TOP_W / 2.0, -TOP_D / 2.0, 0))

# Bearing pocket from top (open top -- bearing inserts from above)
pocket = Part.makeCylinder(TOP_BEARING_POCKET_D / 2.0, TOP_BEARING_POCKET_H)
pocket.translate(FreeCAD.Vector(0, 0, TOP_H - TOP_BEARING_POCKET_H))
top = top.cut(pocket)

# Shaft through-hole
through = Part.makeCylinder(SHAFT_CLEAR / 2.0, TOP_H + 2)
through.translate(FreeCAD.Vector(0, 0, -1))
top = top.cut(through)

# 4x M5 bolt holes with proper 90 degree countersinks on bottom mount face
for i in range(4):
    ang = math.radians(i * 90.0 + 45.0)
    bx = (TOP_BOLT_PCD / 2.0) * math.cos(ang)
    by = (TOP_BOLT_PCD / 2.0) * math.sin(ang)

    bh = Part.makeCylinder(TOP_BOLT_D / 2.0, TOP_H + 2)
    bh.translate(FreeCAD.Vector(bx, by, -1))
    top = top.cut(bh)

    # Conical countersink on BOTTOM mount face
    cs = make_countersink_cone(TOP_BOLT_CS_D_TOP / 2.0, TOP_BOLT_D / 2.0, CSK_DEPTH)
    cs.translate(FreeCAD.Vector(bx, by, 0))
    top = top.cut(cs)

# Apply outer chamfer (V2.1-E: improved filter)
top = apply_outer_chamfer(top, CHAMFER_SIZE)

# Position for visualization (left side)
top.translate(FreeCAD.Vector(-60, 0, 0))

obj_top = doc.addObject("Part::Feature", "BearingHousing_TOP_V2_4")
obj_top.Shape = top
obj_top.ViewObject.ShapeColor = (0.25, 0.55, 0.85)
print(f"  Size:             {TOP_W}x{TOP_D}x{TOP_H}mm")
print(f"  Bearing pocket:   D{TOP_BEARING_POCKET_D:.2f}mm x {TOP_BEARING_POCKET_H}mm")
print(f"  Shaft bore:       D{SHAFT_CLEAR}mm")
print(f"  Countersink:      D{TOP_BOLT_CS_D_TOP}mm x {CSK_DEPTH}mm deep (90 deg)")
print(f"  Volume:           {top.Volume:.0f}mm^3")

# =============================================================================
# BUILD BOTTOM BLOCK
# =============================================================================
print(f"\n[2/3] Building BOTTOM block...")

bot = Part.makeBox(BOT_W, BOT_D, BOT_H)
bot.translate(FreeCAD.Vector(-BOT_W / 2.0, -BOT_D / 2.0, 0))

# V2.4 Stack from BOTTOM to TOP (spring pocket increased to 1.4mm):
#   Z=0    to 3      - solid PETG floor
#   Z=3    to 5      - LOWER washer pocket (2 stacked Koyo AS1226 = 2mm)
#   Z=5    to 14     - 51101 thrust bearing (9mm)
#   Z=14   to 16     - UPPER washer pocket (2 stacked = 2mm)
#   Z=16   to 17.4   - WAVE SPRING pocket (1.4mm, V2.4 increased)
#   Z=17.4 to 19.4   - SPACER RING pocket (2.0mm)
#   Z=19.4 to 28.2   - 6001-2RS radial bearing (8.8mm pocket, recessed)
#   Z=28.2 to 35     - solid PETG top (~6.8mm)

z_cursor = BOT_FLOOR_H  # Z=3

# Lower washer pocket (2 stacked AS1226 washers)
lower_washer = Part.makeCylinder(BOT_WASHER_POCKET_D / 2.0, WASHER_T_STACKED)
lower_washer.translate(FreeCAD.Vector(0, 0, z_cursor))
bot = bot.cut(lower_washer)
z_cursor += WASHER_T_STACKED  # Z=5

# 51101 thrust bearing pocket
thrust_pocket = Part.makeCylinder(BOT_THRUST_POCKET_D / 2.0, THRUST_H)
thrust_pocket.translate(FreeCAD.Vector(0, 0, z_cursor))
bot = bot.cut(thrust_pocket)
z_cursor += THRUST_H  # Z=14

# Upper washer pocket (2 stacked AS1226)
upper_washer = Part.makeCylinder(BOT_WASHER_POCKET_D / 2.0, WASHER_T_STACKED)
upper_washer.translate(FreeCAD.Vector(0, 0, z_cursor))
bot = bot.cut(upper_washer)
z_cursor += WASHER_T_STACKED  # Z=16

# V2.3 NEW: Wave spring pocket
spring_pocket = Part.makeCylinder(SPRING_POCKET_D / 2.0, SPRING_POCKET_H)
spring_pocket.translate(FreeCAD.Vector(0, 0, z_cursor))
bot = bot.cut(spring_pocket)
z_cursor += SPRING_POCKET_H  # Z=17.2

# V2.3 NEW: Spacer ring pocket
spacer_pocket = Part.makeCylinder(SPACER_POCKET_D / 2.0, SPACER_POCKET_H)
spacer_pocket.translate(FreeCAD.Vector(0, 0, z_cursor))
bot = bot.cut(spacer_pocket)
z_cursor += SPACER_POCKET_H  # Z=19.2

# Radial bearing pocket (slip fit + Loctite)
radial_pocket = Part.makeCylinder(BOT_RADIAL_POCKET_D / 2.0, BOT_RADIAL_POCKET_H)
radial_pocket.translate(FreeCAD.Vector(0, 0, z_cursor))
bot = bot.cut(radial_pocket)

# Shaft through-hole (12.3mm)
through = Part.makeCylinder(SHAFT_CLEAR / 2.0, BOT_H + 2)
through.translate(FreeCAD.Vector(0, 0, -1))
bot = bot.cut(through)

# 4x M5 bolt holes with proper 90 degree countersinks on TOP face
for i in range(4):
    ang = math.radians(i * 90.0 + 45.0)
    bx = (BOT_BOLT_PCD / 2.0) * math.cos(ang)
    by = (BOT_BOLT_PCD / 2.0) * math.sin(ang)

    bh = Part.makeCylinder(BOT_BOLT_D / 2.0, BOT_H + 2)
    bh.translate(FreeCAD.Vector(bx, by, -1))
    bot = bot.cut(bh)

    cs = make_countersink_cone(BOT_BOLT_CS_D_TOP / 2.0, BOT_BOLT_D / 2.0, CSK_DEPTH)
    cs.translate(FreeCAD.Vector(bx, by, BOT_H - CSK_DEPTH))
    bot = bot.cut(cs)

# Apply outer chamfer (V2.1-E: improved filter)
bot = apply_outer_chamfer(bot, CHAMFER_SIZE)

# Position BOTTOM block for visualization (right side)
bot.translate(FreeCAD.Vector(60, 0, 0))

obj_bot = doc.addObject("Part::Feature", "BearingHousing_BOTTOM_V2_4")
obj_bot.Shape = bot
obj_bot.ViewObject.ShapeColor = (0.85, 0.45, 0.25)
print(f"  Size:             {BOT_W}x{BOT_D}x{BOT_H}mm")
print(f"  Floor:            {BOT_FLOOR_H}mm solid")
print(f"  Washer pockets:   D{BOT_WASHER_POCKET_D}mm x {WASHER_T_STACKED}mm (2x)")
print(f"  Thrust pocket:    D{BOT_THRUST_POCKET_D}mm x {THRUST_H}mm")
print(f"  Spring pocket:    D{SPRING_POCKET_D}mm x {SPRING_POCKET_H}mm [V2.3 NEW]")
print(f"  Spacer pocket:    D{SPACER_POCKET_D}mm x {SPACER_POCKET_H}mm [V2.3 NEW]")
print(f"  Radial pocket:    D{BOT_RADIAL_POCKET_D:.2f}mm x {BOT_RADIAL_POCKET_H}mm")
print(f"  Shaft bore:       D{SHAFT_CLEAR}mm")
print(f"  Countersink:      D{BOT_BOLT_CS_D_TOP}mm x {CSK_DEPTH}mm deep (90 deg)")
print(f"  Volume:           {bot.Volume:.0f}mm^3")

# =============================================================================
# V2.4 NEW PART -- SPACER TUBE (DETERMINISTIC PRELOAD)
# =============================================================================
print(f"\n[3/3] Building SPACER TUBE (V2.4)...")

# Build spacer tube as hollow cylinder
spacer_outer_cyl = Part.makeCylinder(SPACER_TUBE_OD / 2.0, SPACER_TUBE_LEN)
spacer_inner_cyl = Part.makeCylinder(SPACER_TUBE_ID / 2.0, SPACER_TUBE_LEN + 2)
spacer_inner_cyl.translate(FreeCAD.Vector(0, 0, -1))
spacer_tube = spacer_outer_cyl.cut(spacer_inner_cyl)

# Optional: small assembly chamfers on top/bottom edges
try:
    edges_to_chamfer = []
    bb_sp = spacer_tube.BoundBox
    for e in spacer_tube.Edges:
        # Chamfer only top and bottom edges (horizontal circular edges)
        v1 = e.Vertexes[0].Point
        v2 = e.Vertexes[1].Point
        # Horizontal edge means same Z for both vertices
        if abs(v1.z - v2.z) < 0.01:
            # Only outer edge (at SPACER_TUBE_OD radius)
            r1 = (v1.x**2 + v1.y**2)**0.5
            if abs(r1 - SPACER_TUBE_OD/2.0) < 0.1:
                edges_to_chamfer.append(e)
    if edges_to_chamfer:
        spacer_tube = spacer_tube.makeChamfer(0.5, edges_to_chamfer)
except Exception as e:
    print(f"  Chamfer skipped on spacer: {e}")

# Position spacer tube for visualization (offset in Y so all 3 parts visible)
spacer_tube.translate(FreeCAD.Vector(0, 100, 0))

obj_spacer = doc.addObject("Part::Feature", "SpacerTube_V2_4")
obj_spacer.Shape = spacer_tube
obj_spacer.ViewObject.ShapeColor = (0.55, 0.55, 0.6)  # gray for steel
print(f"  ID:               D{SPACER_TUBE_ID}mm (slip on D12 shaft)")
print(f"  OD:               D{SPACER_TUBE_OD}mm (clears bearing OD)")
print(f"  Length:           {SPACER_TUBE_LEN}mm  *** PRELOAD CRITICAL ***")
print(f"  Tolerance:        +/- {SPACER_TUBE_TOL}mm")
print(f"  Volume:           {spacer_tube.Volume:.0f}mm^3")
print(f"  Block gap design: {BLOCK_GAP}mm (between top of bot block + bot of top block)")
print(f"  Force at 0.5mm spring compression: ~30N (target preload)")

doc.recompute()

# =============================================================================
# EXPORT 1 -- STL
# =============================================================================
print(f"\nExporting STL files...")

top_export = obj_top.Shape.copy()
top_export.translate(FreeCAD.Vector(60, 0, 0))  # cancel -60 offset

bot_export = obj_bot.Shape.copy()
bot_export.translate(FreeCAD.Vector(-60, 0, 0))  # cancel +60 offset

try:
    tmp_top = doc.addObject("Part::Feature", "tmp_top")
    tmp_top.Shape = top_export
    Part.export([tmp_top], PATH_STL_TOP)
    doc.removeObject("tmp_top")
    print(f"  [OK] TOP STL:    {PATH_STL_TOP}")

    tmp_bot = doc.addObject("Part::Feature", "tmp_bot")
    tmp_bot.Shape = bot_export
    Part.export([tmp_bot], PATH_STL_BOT)
    doc.removeObject("tmp_bot")
    print(f"  [OK] BOTTOM STL: {PATH_STL_BOT}")

    Part.export([obj_top, obj_bot], PATH_STL_PAIR)
    print(f"  [OK] PAIR STL:   {PATH_STL_PAIR}")

    # V2.4: Export spacer tube as separate STL (centered at origin)
    spacer_export = obj_spacer.Shape.copy()
    spacer_export.translate(FreeCAD.Vector(0, -100, 0))  # cancel +100 Y offset
    tmp_spacer = doc.addObject("Part::Feature", "tmp_spacer")
    tmp_spacer.Shape = spacer_export
    Part.export([tmp_spacer], PATH_STL_SPACER)
    doc.removeObject("tmp_spacer")
    print(f"  [OK] SPACER STL: {PATH_STL_SPACER}")

except Exception as e:
    print(f"  [FAIL] STL export error: {e}")

# =============================================================================
# EXPORT 2 -- PNG views
# =============================================================================
print(f"\nExporting PNG views...")
try:
    view = FreeCADGui.activeDocument().activeView()

    view.viewIsometric()
    view.fitAll()
    view.saveImage(PATH_PNG_BOTH, 1920, 1080, "Current")
    print(f"  [OK] Both:   {PATH_PNG_BOTH}")

    obj_bot.ViewObject.Visibility = False
    view.fitAll()
    view.saveImage(PATH_PNG_TOP, 1200, 1200, "Current")
    obj_bot.ViewObject.Visibility = True
    print(f"  [OK] TOP:    {PATH_PNG_TOP}")

    obj_top.ViewObject.Visibility = False
    view.fitAll()
    view.saveImage(PATH_PNG_BOT, 1200, 1200, "Current")
    obj_top.ViewObject.Visibility = True
    view.fitAll()
    print(f"  [OK] BOTTOM: {PATH_PNG_BOT}")

except Exception as e:
