    <rect x="-35" y="320" width="70" height="30" fill="#f5e1d8" stroke="#9e4818" stroke-width="1"/>
    <circle cx="0" cy="335" r="14" fill="none" stroke="#999" stroke-width="0.8"/>
    <text x="40" y="338" fill="#9e4818" font-size="8">BOTTOM</text>
    <!-- Bottom plate -->
    <rect x="-50" y="350" width="100" height="6" fill="#c0c0c0" stroke="#666" stroke-width="1"/>
    <text x="55" y="355" fill="#666" font-size="8">Al plate 6mm</text>
    <!-- Labels -->
    <text x="0" y="-5" text-anchor="middle" fill="#333" font-size="9">Shaft Ø12mm × 280mm</text>
  </g>

  <line x1="40" y1="687" x2="960" y2="687" stroke="#1e3a5f" stroke-width="0.3"/>
  <text x="40" y="697" fill="#666" font-size="8">CSM V3 | BearingHousings V1 | April 2026</text>
</svg>'''

try:
    with open(PATH_SVG, 'w', encoding='utf-8') as f:
        f.write(svg_content)
    print(f"  ✅ SVG: {PATH_SVG}")
except Exception as e:
    print(f"  ❌ SVG error: {e}")

