  <!-- Clamp slot (2.2mm wide, crosses bore with -Y spine) -->
  <rect x="278" y="263" width="4" height="197" fill="#fff" stroke="#9e6a18" stroke-width="0.8"/>
  <text x="320" y="430" fill="#666" font-size="9">clamp slot 2.2mm</text>
