# -*- coding: utf-8 -*-
# =============================================================================
# CSM V3 — BEARING HOUSING BLOCKS  V1
# Both TOP and BOTTOM blocks, with auto-export
# =============================================================================
# File:    CSM_V3_BearingHousings_V1.FCMacro
# Date:    April 2026
# Target:  C:\3D-Project\01_MECHANICAL\05_BEARINGS_SHAFT\freecad_macros\
#
# WHAT THIS MAKES:
#   1. TOP bearing housing block — holds 1× 6001-2RS bearing
#      (shaft passes through to cassette above)
#   2. BOTTOM bearing housing block — holds 2× 6001-2RS + 1× 51101 thrust
#      (carries all axial load + cassette weight + belt tension)
#
# BEARINGS USED:
#   6001-2RS:  OD 28mm  ID 12mm  Width 8mm  (radial, sealed)
#   51101:     OD 26mm  ID 12mm  Height 9mm (thrust, axial load only)
#
# FIT STRATEGY:
#   Bearing OD in PETG pocket: -0.05mm (slip-press, hand pressure only)
#   Shaft clearance through block: +1.0mm (never rubs on plastic)
#   Alignment keeps bearings concentric with shaft axis
#
# MOUNTING:
#   Both blocks bolt to 6mm aluminum plate with 4× M5 through bolts
#   Aluminum plate bolts to 2020 extrusion via T-nuts
#   Block M5 holes have countersinks on the mounting face
#
# AUTO-EXPORT ON RUN:
#   STL:        C:\3D-Project\01_MECHANICAL\05_BEARINGS_SHAFT\
#   PNG view:   C:\3D-Project\01_MECHANICAL\05_BEARINGS_SHAFT\images\
#   SVG blueprint: C:\3D-Project\01_MECHANICAL\05_BEARINGS_SHAFT\blueprints\
# =============================================================================

import FreeCAD, FreeCADGui, Part, math, os

# =============================================================================
# OUTPUT PATHS
# =============================================================================
BASE = r"C:\3D-Project\01_MECHANICAL\05_BEARINGS_SHAFT"

PATH_STL_TOP    = os.path.join(BASE, "CSM_V3_BearingHousing_TOP_V1.stl")
PATH_STL_BOT    = os.path.join(BASE, "CSM_V3_BearingHousing_BOTTOM_V1.stl")
PATH_STL_PAIR   = os.path.join(BASE, "CSM_V3_BearingHousings_PAIR_V1.stl")
PATH_PNG_TOP    = os.path.join(BASE, "images", "BearingHousing_TOP_View.png")
PATH_PNG_BOT    = os.path.join(BASE, "images", "BearingHousing_BOTTOM_View.png")
PATH_PNG_BOTH   = os.path.join(BASE, "images", "BearingHousings_Both_View.png")
PATH_SVG        = os.path.join(BASE, "blueprints", "BearingHousings_V1_Blueprint.svg")

for p in [PATH_STL_TOP, PATH_STL_BOT, PATH_PNG_TOP, PATH_SVG]:
    os.makedirs(os.path.dirname(p), exist_ok=True)

doc = FreeCAD.newDocument("CSM_BearingHousings_V1")

# =============================================================================
# BEARING SPECIFICATIONS
# =============================================================================
BEARING_OD      = 28.0    # 6001-2RS outer
BEARING_ID      = 12.0    # 6001-2RS inner (matches shaft)
BEARING_W       = 8.0     # 6001-2RS width

THRUST_OD       = 26.0    # 51101 outer
THRUST_ID       = 12.0    # 51101 inner
THRUST_H        = 9.0     # 51101 height

SHAFT_D         = 12.0    # main shaft diameter
SHAFT_CLEAR     = 13.0    # hole in block, NOT in bearing (shaft only rubs bearings)

# Fit tolerances
PRESS_FIT       = -0.05   # bearing OD press fit (PETG)
POCKET_SLIP     = 0.30    # thrust bearing pocket clearance

# =============================================================================
# TOP BLOCK PARAMETERS
# =============================================================================
TOP_W           = 60.0    # outer dimension X
TOP_D           = 60.0    # outer dimension Y
TOP_H           = 20.0    # height Z
TOP_BEARING_POCKET_D = BEARING_OD + PRESS_FIT   # 27.95mm
TOP_BEARING_POCKET_H = BEARING_W + 0.5          # 8.5mm deep
TOP_BOLT_PCD    = 48.0
TOP_BOLT_D      = 5.5     # M5 clearance
TOP_BOLT_CS_D   = 10.0    # M5 countersink

# =============================================================================
# BOTTOM BLOCK PARAMETERS (larger, more load)
# =============================================================================
BOT_W           = 70.0
BOT_D           = 70.0
BOT_H           = THRUST_H + BEARING_W * 2 + 5.0   # 30mm total

BOT_RADIAL_POCKET_D = BEARING_OD + PRESS_FIT        # 27.95mm (radial bearings)
BOT_RADIAL_POCKET_H = BEARING_W * 2                 # 16mm (2 stacked)
BOT_THRUST_POCKET_D = THRUST_OD + POCKET_SLIP       # 26.3mm (thrust, not press)
BOT_THRUST_POCKET_H = THRUST_H                      # 9mm
BOT_BOLT_PCD        = 56.0
BOT_BOLT_D          = 5.5
BOT_BOLT_CS_D       = 10.0

# Both blocks — common features
CHAMFER_SIZE    = 1.0    # outer edge chamfer for print quality

# =============================================================================
# BUILD TOP BLOCK
# =============================================================================
print("=" * 60)
print("CSM V3 — BEARING HOUSING BLOCKS V1")
print("=" * 60)
print(f"\nBuilding TOP block...")

top = Part.makeBox(TOP_W, TOP_D, TOP_H)
top.translate(FreeCAD.Vector(-TOP_W / 2.0, -TOP_D / 2.0, 0))

# Bearing pocket (top face, open top — bearing press-fits from above)
pocket = Part.makeCylinder(TOP_BEARING_POCKET_D / 2.0, TOP_BEARING_POCKET_H)
pocket.translate(FreeCAD.Vector(0, 0, TOP_H - TOP_BEARING_POCKET_H))
top = top.cut(pocket)

# Shaft through-hole (full height, clearance for shaft)
through = Part.makeCylinder(SHAFT_CLEAR / 2.0, TOP_H + 2)
through.translate(FreeCAD.Vector(0, 0, -1))
top = top.cut(through)

# 4× M5 bolt holes with countersink on bottom (mount face)
for i in range(4):
    ang = math.radians(i * 90.0 + 45.0)
    bx = (TOP_BOLT_PCD / 2.0) * math.cos(ang)
    by = (TOP_BOLT_PCD / 2.0) * math.sin(ang)
    bh = Part.makeCylinder(TOP_BOLT_D / 2.0, TOP_H + 2)
    bh.translate(FreeCAD.Vector(bx, by, -1))
    top = top.cut(bh)
    cs = Part.makeCylinder(TOP_BOLT_CS_D / 2.0, 3.5)
    cs.translate(FreeCAD.Vector(bx, by, 0))
    top = top.cut(cs)

# Position TOP block separately for visualization
top.translate(FreeCAD.Vector(-50, 0, 0))

obj_top = doc.addObject("Part::Feature", "BearingHousing_TOP")
obj_top.Shape = top
obj_top.ViewObject.ShapeColor = (0.25, 0.55, 0.85)
print(f"  TOP: {TOP_W}x{TOP_D}x{TOP_H}mm")
print(f"  Bearing pocket: Ø{TOP_BEARING_POCKET_D}mm × {TOP_BEARING_POCKET_H}mm")
print(f"  Shaft bore: Ø{SHAFT_CLEAR}mm")
print(f"  Volume: {top.Volume:.0f}mm³")

# =============================================================================
# BUILD BOTTOM BLOCK
# =============================================================================
print(f"\nBuilding BOTTOM block...")

bot = Part.makeBox(BOT_W, BOT_D, BOT_H)
bot.translate(FreeCAD.Vector(-BOT_W / 2.0, -BOT_D / 2.0, 0))

# Thrust bearing pocket (BOTTOM, deepest) — slip fit, not press
#
# STACK FROM BOTTOM UP:
#   Z=0 to Z=3: solid floor (3mm)
#   Z=3 to Z=12: thrust bearing pocket (9mm)
#   Z=12 to Z=28: radial bearing pocket (16mm = 2 stacked bearings)
#   Z=28 to Z=30: top face

thrust_pocket = Part.makeCylinder(BOT_THRUST_POCKET_D / 2.0, BOT_THRUST_POCKET_H)
thrust_pocket.translate(FreeCAD.Vector(0, 0, 3.0))
bot = bot.cut(thrust_pocket)

# Radial bearing pocket (stacked 2× bearings) — press fit
radial_pocket = Part.makeCylinder(BOT_RADIAL_POCKET_D / 2.0, BOT_RADIAL_POCKET_H)
radial_pocket.translate(FreeCAD.Vector(0, 0, 3.0 + BOT_THRUST_POCKET_H))
bot = bot.cut(radial_pocket)

# Shaft through-hole (full height)
through = Part.makeCylinder(SHAFT_CLEAR / 2.0, BOT_H + 2)
through.translate(FreeCAD.Vector(0, 0, -1))
bot = bot.cut(through)

# Small cutout in bottom for shaft end clearance (if shaft extends past thrust)
shaft_clearance_bottom = Part.makeCylinder(SHAFT_D / 2.0 + 1.0, 4.0)
shaft_clearance_bottom.translate(FreeCAD.Vector(0, 0, -1))
bot = bot.cut(shaft_clearance_bottom)

# 4× M5 bolt holes with countersink on top (mount face UP — bolts thread down through plate)
# Bottom block mounts UNDER the aluminum plate, bolts come from above
for i in range(4):
    ang = math.radians(i * 90.0 + 45.0)
    bx = (BOT_BOLT_PCD / 2.0) * math.cos(ang)
    by = (BOT_BOLT_PCD / 2.0) * math.sin(ang)
    bh = Part.makeCylinder(BOT_BOLT_D / 2.0, BOT_H + 2)
    bh.translate(FreeCAD.Vector(bx, by, -1))
    bot = bot.cut(bh)
    # Countersink on TOP (facing up toward the plate)
    cs = Part.makeCylinder(BOT_BOLT_CS_D / 2.0, 3.5)
    cs.translate(FreeCAD.Vector(bx, by, BOT_H - 3.5))
    bot = bot.cut(cs)

# Position BOTTOM block for visualization
bot.translate(FreeCAD.Vector(50, 0, 0))

obj_bot = doc.addObject("Part::Feature", "BearingHousing_BOTTOM")
obj_bot.Shape = bot
obj_bot.ViewObject.ShapeColor = (0.85, 0.45, 0.25)
print(f"  BOTTOM: {BOT_W}x{BOT_D}x{BOT_H}mm")
print(f"  Thrust pocket: Ø{BOT_THRUST_POCKET_D}mm × {BOT_THRUST_POCKET_H}mm (bottom)")
print(f"  Radial pocket: Ø{BOT_RADIAL_POCKET_D}mm × {BOT_RADIAL_POCKET_H}mm (above thrust)")
print(f"  Shaft bore: Ø{SHAFT_CLEAR}mm")
print(f"  Volume: {bot.Volume:.0f}mm³")

doc.recompute()

# =============================================================================
# EXPORT 1 — STL (individual + pair)
# =============================================================================
print(f"\nExporting STL files...")

# Reset positions for proper export (each part at origin)
top_export = obj_top.Shape.copy()
top_export.translate(FreeCAD.Vector(50, 0, 0))  # cancel the -50 offset

bot_export = obj_bot.Shape.copy()
bot_export.translate(FreeCAD.Vector(-50, 0, 0))  # cancel the +50 offset

try:
    # Individual STLs
    tmp_top = doc.addObject("Part::Feature", "tmp_top")
    tmp_top.Shape = top_export
    Part.export([tmp_top], PATH_STL_TOP)
    doc.removeObject("tmp_top")
    print(f"  ✅ TOP STL:    {PATH_STL_TOP}")

    tmp_bot = doc.addObject("Part::Feature", "tmp_bot")
    tmp_bot.Shape = bot_export
    Part.export([tmp_bot], PATH_STL_BOT)
    doc.removeObject("tmp_bot")
    print(f"  ✅ BOTTOM STL: {PATH_STL_BOT}")

    # Pair STL (both together, as positioned in view)
    Part.export([obj_top, obj_bot], PATH_STL_PAIR)
    print(f"  ✅ PAIR STL:   {PATH_STL_PAIR}")

except Exception as e:
    print(f"  ❌ STL export error: {e}")

# =============================================================================
# EXPORT 2 — PNG views
# =============================================================================
print(f"\nExporting PNG views...")
try:
    view = FreeCADGui.activeDocument().activeView()

    # Both blocks together
    view.viewIsometric()
    view.fitAll()
    view.saveImage(PATH_PNG_BOTH, 1920, 1080, "Current")
    print(f"  ✅ Both:   {PATH_PNG_BOTH}")

    # Top only
    obj_bot.ViewObject.Visibility = False
    view.fitAll()
    view.saveImage(PATH_PNG_TOP, 1200, 1200, "Current")
    obj_bot.ViewObject.Visibility = True
    print(f"  ✅ TOP:    {PATH_PNG_TOP}")

    # Bottom only
    obj_top.ViewObject.Visibility = False
    view.fitAll()
    view.saveImage(PATH_PNG_BOT, 1200, 1200, "Current")
    obj_top.ViewObject.Visibility = True
    view.fitAll()
    print(f"  ✅ BOTTOM: {PATH_PNG_BOT}")

except Exception as e:
    print(f"  ⚠️  PNG export skipped: {e}")

# =============================================================================
# EXPORT 3 — SVG Blueprint (both blocks, dimensioned)
# =============================================================================
print(f"\nGenerating SVG blueprint...")

svg_content = '''<svg viewBox="0 0 1000 700" xmlns="http://www.w3.org/2000/svg" font-family="Arial, sans-serif">
  <rect width="1000" height="700" fill="#fafaf8"/>

  <text x="500" y="32" text-anchor="middle" fill="#1a1a1a" font-size="17" font-weight="bold">BEARING HOUSING BLOCKS V1 — BLUEPRINT</text>
  <text x="500" y="50" text-anchor="middle" fill="#666" font-size="11">Top + Bottom blocks · PETG · shaft Ø12mm</text>
  <line x1="40" y1="62" x2="960" y2="62" stroke="#1e3a5f" stroke-width="0.8"/>

