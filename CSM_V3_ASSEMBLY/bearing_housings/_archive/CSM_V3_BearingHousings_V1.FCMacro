  <polygon points="130,523 130,510 142,510" fill="#e24b4a" opacity="0.5"/>
  <polygon points="338,523 338,510 350,510" fill="#e24b4a" opacity="0.5"/>
  <text x="130" y="540" fill="#791F1F" font-size="8">csk bottom</text>

